/* 客户服务表单沿用商城的暖白与深绿色. */
.service-form {
    box-sizing: border-box;
    width: 100%;
    max-width: 960rpx;
    margin: 0 auto;
    padding: 46rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.service-title {
    color: #26312d;
    font-size: 44rpx;
    font-weight: 600;
    line-height: 1.3;
}
.service-description {
    margin: 14rpx 0 34rpx;
    color: #5c675f;
    font-size: 26rpx;
    line-height: 1.6;
}
.service-card {
    padding: 28rpx;
    background: #fffdf9;
    border: 1rpx solid #ddd8cd;
    border-radius: 16rpx;
}
.service-field + .service-field {
    margin-top: 28rpx;
}
.service-label {
    display: block;
    margin-bottom: 12rpx;
    color: #26312d;
    font-size: 26rpx;
    font-weight: 600;
}
.service-input,
.service-picker,
.service-textarea {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    height: 88rpx;
    padding: 0 20rpx;
    color: #26312d;
    background: #f8f6f0;
    border: 1rpx solid #d9d5ca;
    border-radius: 10rpx;
    font-size: 29rpx;
}
.service-placeholder { color: #68736a; }
.service-action {
    margin: 32rpx 0 0;
    border-radius: 10rpx;
    color: #fff;
    background: #294d3e;
    font-weight: 600;
    line-height: 88rpx;
}
.service-action[disabled] {
    color: #4e5d55;
    background: #e2e8e3;
}
