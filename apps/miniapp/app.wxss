/**app.wxss**/
.container {
    box-sizing: border-box;
    background-color: #f3f0ea;
    font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

view,
image,
text,
navigator {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
}

view,
text {
    font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
    font-size: 28rpx;
    color: #26312d;
}

button::after {
    display: none;
}

.display-none {
    display: none !important;
}

::-webkit-scrollbar {
    width: 5px;
    background-color: #f5f5f5;
}

::-webkit-scrollbar-thumb {
    background-color: #999;
}

/* 克拉匠造移动端视觉基础 / CaratCraft mobile visual foundation. */
page {
    background: #f3f0ea;
    color: #26312d;
}

button {
    border-radius: 4rpx;
    font-size: 28rpx;
}

input,
textarea {
    color: #26312d;
    font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.empty-view,
.search-result-empty,
.no-cart .c {
    align-items: center;
    background: #fbfaf7;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 24rpx;
    min-height: 460rpx;
    padding: 56rpx 36rpx;
}

.empty-view .title,
.search-result-empty .text,
.no-cart .title-box {
    color: #26312d;
    font-family: serif;
    font-size: 34rpx;
    font-weight: 600;
}

.empty-view .desc {
    color: #92897e;
    font-size: 24rpx;
    line-height: 1.6;
    margin-top: 14rpx;
}

.bottom-btn,
.to-index-btn {
    background: #9d7139;
    border-radius: 2rpx;
    color: #fff;
}
