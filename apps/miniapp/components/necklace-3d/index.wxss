:host {
    display: block;
}

.scene {
    background: #ede7eb;
    border-radius: 20rpx;
    height: 560rpx;
    overflow: hidden;
    position: relative;
}

.surface {
    display: block;
    height: 100%;
    width: 100%;
}

.loading {
    background: #fff;
    border-radius: 14rpx;
    text-align: center;
    width: 80%;
    color: #292337;
    font-size: 25rpx;
    left: 50%;
    padding: 12rpx;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
}

.caption {
    color: #665a70;
    font-size: 22rpx;
    margin-top: 8rpx;
}

.view-reset {
    background: #fff;
    border-radius: 12rpx;
    bottom: 14rpx;
    color: #4d345b;
    position: absolute;
    right: 14rpx;
}

.view-reset::after {
    border: 0;
}