:host {
    display: block;
}

.scene {
    background: #e4dcd0;
    height: 560rpx;
    overflow: hidden;
    position: relative;
}

.surface {
    display: block;
    height: 100%;
    width: 100%;
}

.loading {
    background: #f8f5ee;
    color: #37483a;
    font-size: 25rpx;
    left: 50%;
    padding: 12rpx;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
}

.caption {
    color: #526152;
    font-size: 22rpx;
    margin-top: 8rpx;
}
