<view class="container">
    <view class="pay-result">
        <view class="success" wx:if="{{status === 'paid'}}"><view class="msg">付款成功</view></view>
        <view wx:else><view class="msg">支付结果待确认</view><view class="tips">请以服务端订单状态为准, 不要因网络延迟重复付款.</view></view>
        <view wx:if="{{error}}">{{error}}</view>
        <button bindtap="updateSuccess" loading="{{checking}}" disabled="{{!orderId || checking || paying}}">查询支付结果</button>
        <button wx:if="{{status !== 'paid'}}" bindtap="payOrder" loading="{{paying}}" disabled="{{!orderId || checking || paying}}">重新支付</button>
        <navigator class="btn" url="/pages/ucenter/order/order" open-type="redirect">查看订单</navigator>
        <navigator class="btn" url="/pages/index/index" open-type="switchTab">继续逛</navigator>
    </view>
</view>
<merchant-contact />
