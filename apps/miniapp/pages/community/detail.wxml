<view class="community-page">
    <view wx:if="{{loading}}" class="state">正在读取分享…</view>
    <view wx:if="{{error}}" class="state">{{error}}<button size="mini" bindtap="load">重试</button></view>
    <view wx:if="{{post}}" class="post-card">
        <view class="post-meta">{{post.kindText}} · {{post.createTime}}</view><view class="post-title">{{post.title}}</view><view class="post-content">{{post.content}}</view>
        <view class="post-images"><image wx:for="{{post.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview" /></view>
        <view wx:if="{{post.arrangement.length}}" class="public-design"><view class="post-title">设计作品</view>
            <necklace-3d read-only="{{true}}" option-ids="{{post.publicOptionIds}}" groups="{{post.publicGroups}}" />
            <view wx:for="{{post.arrangement}}" wx:key="position" class="design-line">{{index + 1}}. {{item.name}} · {{item.sizeMm ? item.sizeMm + 'mm' : '尺寸未配置'}} <text wx:if="{{item.shape}}"> · {{item.shape}}{{item.luster ? ' / ' + item.luster : ''}}{{item.blemish ? ' / ' + item.blemish : ''}}</text></view></view>
        <view class="post-footer"><button wx:if="{{post.canRecreate}}" size="mini" bindtap="recreate">制作同款</button><button size="mini" bindtap="like" loading="{{busy}}" disabled="{{busy}}">{{liked ? '已赞' : '赞'}} {{post.likes}}</button><button wx:if="{{owned}}" size="mini" bindtap="remove">删除分享</button></view>
    </view>
</view>
