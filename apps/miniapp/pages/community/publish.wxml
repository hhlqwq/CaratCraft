<view class="community-page"><view class="page-title">记录一份灵感</view><view class="community-note">只发布本人有权公开的图片与内容, 请勿填写地址、电话等隐私信息。审核通过后公开。</view>
    <view class="publish-form"><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="kind" disabled="{{saving}}"><view class="form-field">分享类型: {{kinds[kindIndex]}} ›</view></picker>
    <input class="title-input" maxlength="60" placeholder="给分享起个标题 (最多60字)" value="{{title}}" data-field="title" bindinput="input" disabled="{{saving}}" />
    <textarea class="content-input" maxlength="2000" placeholder="聊聊设计思路、成品感受或改进建议…" value="{{content}}" data-field="content" bindinput="input" disabled="{{saving}}" />
    <view class="community-note">{{content.length}} / 2000</view>
    <view wx:if="{{kindIndex === 0}}" class="design-select"><view class="post-title">附上我的设计</view>
        <view wx:if="{{loadingDesigns}}" class="community-note">正在读取本人设计…</view>
        <view wx:elif="{{designError}}" class="community-note">{{designError}}<button size="mini" bindtap="loadDesigns">重试</button></view>
        <view wx:elif="{{!designs.length}}" class="community-note">请先到DIY保存一份材料排列, 再回来分享。</view>
        <picker wx:else range="{{designLabels}}" value="{{designIndex < 0 ? 0 : designIndex}}" bindchange="selectDesign" disabled="{{saving}}"><view class="form-field">{{designIndex < 0 ? '选择本人设计 ›' : designLabels[designIndex]}}</view></picker>
        <checkbox-group bindchange="consent"><label class="community-note"><checkbox value="yes" checked="{{consent}}" disabled="{{saving}}" />我同意公开所选设计的材料名称、顺序及尺寸副本, 不包含私人刻字和订单。</label></checkbox-group>
    </view>
    <view class="post-images"><view class="upload-image" wx:for="{{images}}" wx:key="id"><image src="{{item.previewUrl}}" mode="aspectFill" /><button size="mini" data-id="{{item.id}}" bindtap="removeImage" disabled="{{uploading || saving}}">移除</button></view></view>
    <button class="add-image" bindtap="chooseImages" disabled="{{uploading || saving || images.length >= 6}}">{{uploading ? uploadProgress : '添加图片 (' + images.length + '/6)'}} </button>
    <view wx:if="{{error}}" class="moderation-note">{{error}}</view><button class="submit-post" bindtap="submit" loading="{{saving}}" disabled="{{saving || uploading}}">提交审核</button></view>
</view>

<merchant-contact />
