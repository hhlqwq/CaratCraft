<view class="community-page">
    <view class="community-heading"><view><view class="eyebrow">珍珠与日常</view><view class="page-title">分享你的灵感</view></view><button size="mini" bindtap="compose">发布分享</button></view>
    <view class="community-note">分享设计、成品与建议。社区仅支持点赞, 内容审核后公开。</view>
    <view class="filters"><view wx:for="{{kinds}}" wx:key="key" class="filter {{!mine && kind === item.key ? 'selected' : ''}}" data-kind="{{item.key}}" bindtap="filter">{{item.name}}</view><view class="filter {{mine ? 'selected' : ''}}" bindtap="toggleMine">我的分享</view></view>
    <view wx:if="{{error}}" class="state">{{error}}<button size="mini" bindtap="retry">重试</button></view>
    <view wx:if="{{!loading && !error && !records.length}}" class="empty"><view class="empty-title">{{mine ? '还没有分享' : '等待第一份灵感'}}</view><view>记录你的设计过程, 或分享成品的佩戴感受。</view><button size="mini" bindtap="compose">写一条分享</button></view>
    <view wx:for="{{records}}" wx:key="id" class="post-card">
        <view data-id="{{item.id}}" bindtap="open"><view class="post-meta">{{item.kindText}} <text wx:if="{{mine}}"> · {{item.statusText}}</text></view><view class="post-title">{{item.title}}</view><view class="post-content">{{item.content}}</view>
            <view class="post-images"><image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" src="{{image}}" mode="aspectFill" /></view>
            <view wx:if="{{item.arrangement.length}}" class="design-summary">含公开材料排列 · {{item.arrangement.length}}个实例</view>
        </view>
        <view wx:if="{{mine && item.moderationReason}}" class="moderation-note">审核说明: {{item.moderationReason}}</view>
        <view class="post-footer"><text>{{item.createTime}}</text><button wx:if="{{!mine || item.status === 'PUBLISHED'}}" size="mini" data-id="{{item.id}}" bindtap="like">{{item.liked ? '已赞' : '赞'}} {{item.likes}}</button><button wx:if="{{mine || item.owned}}" size="mini" data-id="{{item.id}}" bindtap="remove">删除</button></view>
    </view>
    <view wx:if="{{loading}}" class="state">正在加载分享…</view><view wx:elif="{{records.length && records.length >= total}}" class="end-note">已展示全部分享</view>
</view>

