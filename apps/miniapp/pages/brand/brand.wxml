<view wx:if="{{loading}}">正在加载...</view>
<view wx:if="{{error}}">{{error}}<button bindtap="retryLoad">重新读取</button></view>
<view wx:if="{{!loading && !error && !brandList.length}}">暂无内容</view>
<view class="container">
    <view class="brand-list" >
        <navigator url="../brandDetail/brandDetail?id={{item.id}}"  class="item" wx:for="{{brandList}}" wx:key="id">
            <view class="img-bg">
                <image src="{{item.appListPicUrl}}" background-size="cover" webp="{{true}}"></image>
            </view>
            <view class="txt-box">
                <view class="line">
                    <text class="name" >{{item.name}}</text>
                    <text class="s">|</text>
                    <text class="price">{{item.floorPrice}}元起</text>
                </view>
            </view>
        </navigator >
    </view>
</view>
