.home-page {
    background: #f3f0ea;
    min-height: 100vh;
    padding-bottom: 48rpx;
}

.home-hero {
    background: #182421;
    color: #fff;
    padding: 64rpx 36rpx 42rpx;
    position: relative;
}

.home-hero::after {
    border: 1rpx solid rgba(214, 181, 119, 0.35);
    border-radius: 50%;
    content: '';
    height: 280rpx;
    position: absolute;
    right: -120rpx;
    top: -90rpx;
    width: 280rpx;
}

.brand-kicker,
.eyebrow,
.atelier-kicker {
    color: #cbb37d;
    display: block;
    font-size: 20rpx;
    font-weight: 600;
    letter-spacing: 4rpx;
}

.hero-title {
    color: #fff;
    font-family: serif;
    font-size: 56rpx;
    font-weight: 500;
    line-height: 1.25;
    margin-top: 22rpx;
    max-width: 590rpx;
}

.hero-title text {
    color: #dfc790;
    display: block;
    font-family: serif;
    font-size: 56rpx;
}

.hero-copy {
    color: rgba(255, 255, 255, 0.66);
    font-size: 24rpx;
    line-height: 1.7;
    margin-top: 20rpx;
}

.search-box {
    align-items: center;
    background: #fff;
    border-radius: 8rpx;
    display: flex;
    height: 92rpx;
    margin-top: 38rpx;
    padding-left: 26rpx;
    position: relative;
    z-index: 1;
}

.search-symbol {
    border: 3rpx solid #756c60;
    border-radius: 50%;
    height: 24rpx;
    margin-right: 22rpx;
    position: relative;
    width: 24rpx;
}

.search-symbol::after {
    background: #756c60;
    bottom: -8rpx;
    content: '';
    height: 3rpx;
    position: absolute;
    right: -8rpx;
    transform: rotate(45deg);
    width: 13rpx;
}

.search-input {
    color: #1d2724;
    flex: 1;
    font-size: 27rpx;
    height: 92rpx;
}

.search-action {
    align-items: center;
    background: #c29a58;
    color: #17231f;
    display: flex;
    font-size: 25rpx;
    font-weight: 600;
    height: 92rpx;
    justify-content: center;
    width: 122rpx;
}

.keyword-strip,
.product-scroll {
    white-space: nowrap;
}

.keyword-strip {
    margin-top: 22rpx;
}

.keyword-chip {
    border: 1rpx solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.72);
    display: inline-block;
    font-size: 22rpx;
    margin-right: 14rpx;
    padding: 10rpx 20rpx;
}

.function-panel,
.product-section {
    background: #fff;
    margin: 24rpx;
    padding: 34rpx 28rpx;
}

.section-heading {
    align-items: flex-end;
    display: flex;
    justify-content: space-between;
}

.section-title {
    color: #1c2522;
    display: block;
    font-family: serif;
    font-size: 38rpx;
    font-weight: 600;
    margin-top: 8rpx;
}

.section-note,
.view-more {
    color: #8b8276;
    font-size: 22rpx;
}

.function-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 32rpx;
    row-gap: 34rpx;
}

.function-item {
    text-align: center;
}

.function-mark {
    align-items: center;
    background: #eef0ea;
    border-radius: 50%;
    color: #446054;
    display: flex;
    font-family: serif;
    font-size: 28rpx;
    height: 72rpx;
    justify-content: center;
    margin: 0 auto;
    width: 72rpx;
}

.function-item:nth-child(4n + 2) .function-mark,
.function-item:nth-child(4n + 3) .function-mark {
    background: #f2e9dd;
    color: #9a6f3b;
}

.function-name {
    color: #26312d;
    font-size: 24rpx;
    font-weight: 600;
    margin-top: 14rpx;
}

.function-caption {
    color: #aaa195;
    font-size: 19rpx;
    margin-top: 4rpx;
}

.atelier-banner {
    align-items: center;
    background: #c49a58;
    display: flex;
    margin: 24rpx;
    min-height: 220rpx;
    overflow: hidden;
    padding: 34rpx;
    position: relative;
}

.atelier-number {
    color: rgba(24, 36, 33, 0.14);
    font-family: serif;
    font-size: 150rpx;
    font-weight: 700;
    left: -12rpx;
    position: absolute;
    top: 6rpx;
}

.atelier-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-left: 64rpx;
    position: relative;
}

.atelier-kicker {
    color: #314139;
}

.atelier-title {
    color: #17231f;
    font-family: serif;
    font-size: 38rpx;
    font-weight: 600;
    margin-top: 10rpx;
}

.atelier-copy {
    color: rgba(23, 35, 31, 0.68);
    font-size: 22rpx;
    line-height: 1.55;
    margin-top: 10rpx;
    max-width: 470rpx;
}

.atelier-arrow {
    align-items: center;
    border: 1rpx solid rgba(23, 35, 31, 0.4);
    border-radius: 50%;
    color: #17231f;
    display: flex;
    font-size: 34rpx;
    height: 64rpx;
    justify-content: center;
    width: 64rpx;
}

.product-heading {
    margin-bottom: 30rpx;
}

.product-scroll {
    margin-right: -28rpx;
}

.product-card {
    display: inline-block;
    margin-right: 18rpx;
    position: relative;
    vertical-align: top;
    width: 274rpx;
}

.product-image {
    background: #f1efeb;
    height: 310rpx;
    width: 274rpx;
}

.demo-label {
    background: #24352f;
    color: #fff;
    font-size: 18rpx;
    left: 12rpx;
    letter-spacing: 2rpx;
    padding: 7rpx 12rpx;
    position: absolute;
    top: 12rpx;
    z-index: 1;
}

.product-name,
.editorial-name {
    color: #26312d;
    font-size: 26rpx;
    font-weight: 600;
    margin-top: 16rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.product-price,
.editorial-price {
    color: #a87435;
    font-family: serif;
    font-size: 29rpx;
    margin-top: 8rpx;
}

.editorial-card {
    border-top: 1rpx solid #e8e2d9;
    display: flex;
    padding: 24rpx 0;
}

.editorial-card:first-child {
    border-top: 0;
    padding-top: 0;
}

.editorial-image {
    background: #f1efeb;
    height: 190rpx;
    width: 190rpx;
}

.editorial-info {
    flex: 1;
    min-width: 0;
    padding-left: 28rpx;
    position: relative;
}

.editorial-index {
    color: #c3b9aa;
    font-family: serif;
    font-size: 20rpx;
    letter-spacing: 2rpx;
}

.editorial-desc {
    color: #948b7e;
    font-size: 22rpx;
    line-height: 1.5;
    margin-top: 10rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
