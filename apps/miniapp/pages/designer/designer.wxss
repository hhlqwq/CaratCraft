.page {
    background: #f8f6f3;
    box-sizing: border-box;
    min-height: 100vh;
    padding: 22rpx 22rpx 220rpx;
}

.config-state {
    background: #ffffff;
    color: #665a70;
    font-size: 25rpx;
    margin-top: 18rpx;
    padding: 28rpx 24rpx;
    text-align: center;
}

.config-state.error {
    color: #943f55;
}

.config-state-title {
    color: #292337;
    font-size: 29rpx;
    font-weight: 700;
}

.config-state-description {
    margin-top: 10rpx;
}

.config-retry {
    background: #4d345b;
    color: #ffffff;
    font-size: 25rpx;
    margin-top: 18rpx;
}

/* 预览区 */
.stage-card {
    background: #ffffff;
    padding: 24rpx;
}

.stage-head {
    margin-bottom: 14rpx;
}

.stage-title {
    color: #292337;
    font-size: 30rpx;
    font-weight: 700;
}

.stage-title-row {
    align-items: center;
    display: flex;
    gap: 16rpx;
}

.style-back {
    color: #665a70;
    font-size: 24rpx;
}

.stage-price {
    color: #4d345b;
    font-size: 27rpx;
    font-weight: 700;
}

.active-bar {
    align-items: center;
    background: #f4eef6;
    border-radius: 12rpx;
    display: flex;
    justify-content: space-between;
    margin-top: 14rpx;
    padding: 12rpx 18rpx;
}

.active-name {
    color: #292337;
    flex: 1;
    font-size: 24rpx;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.active-actions {
    align-items: center;
    display: flex;
}

.action {
    color: #4d345b;
    font-size: 24rpx;
    margin-left: 22rpx;
}

.action.danger {
    color: #943f55;
}

.copy-count {
    background: #ffffff;
    border: 1rpx solid #e6e0e8;
    border-radius: 8rpx;
    font-size: 22rpx;
    height: 44rpx;
    margin-left: 8rpx;
    text-align: center;
    width: 64rpx;
}

/* 工具行 */
.stage-tools {
    display: flex;
    justify-content: flex-end;
    margin-top: 12rpx;
}

.tool {
    color: #665a70;
    font-size: 24rpx;
    margin-left: 30rpx;
}

.tool-disabled {
    color: #e6e0e8;
}

.detail-panel {
    border-top: 1rpx solid #eee6f0;
    margin-top: 12rpx;
    padding-top: 10rpx;
}

.bom-line {
    color: #665a70;
    font-size: 23rpx;
    line-height: 1.9;
}

.preview-disclaimer {
    color: #665a70;
    font-size: 21rpx;
    line-height: 1.6;
    margin-top: 10rpx;
}

/* 材料选择区 */
.material-card {
    background: #ffffff;
    margin-top: 18rpx;
    padding: 20rpx 0 18rpx;
}

.group-tabs {
    white-space: nowrap;
}

.group-tab {
    color: #665a70;
    display: inline-block;
    font-size: 26rpx;
    margin: 0 8rpx;
    padding: 12rpx 24rpx;
}

.group-tab-active {
    background: #4d345b;
    border-radius: 14rpx;
    color: #ffffff;
    font-weight: 600;
}

.required-mark {
    color: #9276a0;
    margin-left: 4rpx;
}

.option-strip {
    margin-top: 16rpx;
    padding: 0 12rpx;
    white-space: nowrap;
}

.option {
    background: #f8f6f3;
    border: 2rpx solid transparent;
    border-radius: 14rpx;
    box-sizing: border-box;
    display: inline-flex;
    flex-direction: column;
    margin: 0 8rpx;
    padding: 14rpx 12rpx;
    vertical-align: top;
    width: 176rpx;
}

.option-selected {
    background: #f4eef6;
    border-color: #9276a0;
}

.option-image {
    height: 120rpx;
    width: 100%;
}

.option-name {
    color: #292337;
    font-size: 22rpx;
    line-height: 1.4;
    margin-top: 10rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.option-price {
    color: #4d345b;
    font-size: 21rpx;
    margin-top: 6rpx;
}

.material-hint {
    color: #665a70;
    font-size: 21rpx;
    margin-top: 12rpx;
    padding: 0;
}

/* 尺寸与规则参考 */
.sizing-card {
    background: #ffffff;
    margin-top: 18rpx;
    padding: 22rpx 24rpx;
}

.sizing-toggle {
    align-items: center;
    display: flex;
    justify-content: space-between;
}

.sizing-title {
    color: #292337;
    font-size: 28rpx;
    font-weight: 700;
}

.sizing-description {
    color: #665a70;
    font-size: 22rpx;
    margin-top: 6rpx;
}

.sizing-icon {
    color: #665a70;
    font-size: 24rpx;
}

.sizing-panel {
    margin-top: 18rpx;
}

.sizing-fields label {
    color: #665a70;
    display: block;
    font-size: 24rpx;
    margin-bottom: 14rpx;
}

.sizing-fields input {
    background: #f8f6f3;
    border-radius: 10rpx;
    font-size: 25rpx;
    margin-top: 8rpx;
    padding: 14rpx 18rpx;
}

.reference-preference {
    color: #4d345b;
    font-size: 25rpx;
    margin: 8rpx 0 14rpx;
}

.reference-preference text {
    color: #4d345b;
}

.reference-action {
    background: #4d345b;
    color: #ffffff;
    font-size: 25rpx;
}

.reference-result {
    background: #f8f6f3;
    border-radius: 12rpx;
    margin-top: 16rpx;
    padding: 18rpx;
}

.reference-length {
    color: #292337;
    font-size: 26rpx;
    font-weight: 700;
}

.reference-reason {
    color: #292337;
    font-size: 24rpx;
    margin-top: 8rpx;
}

.reference-note {
    color: #665a70;
    font-size: 22rpx;
    line-height: 1.7;
    margin-top: 8rpx;
}

.engraving {
    background: #f8f6f3;
    border-radius: 10rpx;
    font-size: 25rpx;
    margin-top: 16rpx;
    padding: 14rpx 18rpx;
}

/* 底部操作 */
.bottom-bar {
    background: #ffffff;
    bottom: 0;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    gap: 8rpx 16rpx;
    left: 0;
    padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
    position: fixed;
    width: 100%;
    z-index: 20;
}

.bottom-bar button {
    border-radius: 14rpx;
    font-size: 28rpx;
    margin: 0;
    min-height: 72rpx;
}

.bottom-bar .secondary {
    background: #eee6f0;
    color: #4d345b;
    flex: 1;
}

.bottom-bar .primary {
    background: #4d345b;
    color: #ffffff;
    flex: 2;
}

/* 款式入口与当前编辑动作. */
.style-picker {
    background: #ffffff;
    padding: 36rpx 28rpx;
}

.style-help {
    color: #665a70;
    font-size: 26rpx;
    margin-top: 12rpx;
}

.style-choice {
    align-items: center;
    background: #f8f6f3;
    color: #292337;
    display: flex;
    font-size: 28rpx;
    gap: 16rpx;
    justify-content: space-between;
    margin-top: 24rpx;
    padding: 12rpx 22rpx;
    text-align: left;
}

.style-arrow {
    color: #4d345b;
}

.designs-link {
    background: transparent;
    color: #4d345b;
    font-size: 26rpx;
    margin-top: 24rpx;
}

.designs-link::after,
.mode-button::after {
    border: 0;
}

.material-actions {
    display: flex;
    gap: 12rpx;
}

.mode-button {
    background: #f8f6f3;
    border-radius: 10rpx;
    color: #292337;
    flex: 1;
    font-size: 25rpx;
}

.mode-button.mode-active {
    background: #4d345b;
    color: #ffffff;
}

.mode-button[disabled] {
    color: #665a70;
}

.length-summary {
    color: #665a70;
    display: flex;
    flex-wrap: wrap;
    font-size: 23rpx;
    gap: 8rpx 24rpx;
    margin-top: 14rpx;
}

.bottom-bar button[disabled] {
    background: #eeeaf0;
    color: #665a70;
}

.checkout-status {
    color: #4d345b;
    flex-basis: 100%;
    font-size: 22rpx;
    max-height: 100rpx;
    overflow-y: auto;
}

.clear-group {
    color: #943f55;
    display: inline-block;
    font-size: 23rpx;
    padding: 12rpx 0 0;
}


.stage-links,
.add-count {
    align-items: center;
    display: flex;
    gap: 8rpx;
}

.stage-links {
    margin-left: auto;
}

.style-back,
.instance {
    background: #fff;
    border: 1rpx solid #e6e0e8;
    border-radius: 12rpx;
    color: #4d345b;
    font-size: 24rpx;
    line-height: 64rpx;
    margin: 0;
    padding: 0 14rpx;
}

.style-back::after,
.instance::after {
    border: 0;
}

.arrangement-list,
.variant-strip {
    margin: 12rpx 0;
    white-space: nowrap;
    width: 100%;
}

.instance {
    display: inline-block;
    line-height: 56rpx;
    margin-right: 8rpx;
}

.instance-active {
    background: #eee6f0;
    border-color: #baabc2;
}

.metric {
    color: #292337;
    display: block;
    font-size: 29rpx;
    font-weight: 650;
}

.add-count,
.option-info,
.option-placeholder,
.measurement-guide {
    color: #665a70;
    font-size: 23rpx;
}

.option-placeholder {
    align-items: center;
    background: #eee6f0;
    border-radius: 10rpx;
    display: flex;
    height: 86rpx;
    justify-content: center;
}

.measurement-guide {
    background: #f8f6f3;
    border-radius: 12rpx;
    line-height: 1.6;
    margin-bottom: 12rpx;
    padding: 12rpx;
}


.neck-measure {
    align-items: center;
    color: #665a70;
    display: flex;
    font-size: 24rpx;
    gap: 14rpx;
    margin-bottom: 18rpx;
    position: relative;
}

.neck-outline {
    border: solid #baabc2;
    border-radius: 8rpx 8rpx 30rpx 30rpx;
    border-width: 0 2rpx 2rpx;
    height: 48rpx;
    width: 74rpx;
}

.tape-line {
    border: 2rpx solid #4d345b;
    border-radius: 50%;
    height: 15rpx;
    left: -3rpx;
    position: absolute;
    top: 19rpx;
    transform: rotate(-6deg);
    width: 80rpx;
}
