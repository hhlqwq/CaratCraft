.page {
    background: #f5f1e9;
    box-sizing: border-box;
    min-height: 100vh;
    padding: 22rpx 22rpx 160rpx;
}

.intro-card {
    background: #183d35;
    color: #fffdf8;
    padding: 30rpx 28rpx;
}

.intro-eyebrow {
    color: #e8c887;
    font-size: 24rpx;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.intro-title {
    font-family: serif;
    font-size: 42rpx;
    font-weight: 600;
    margin-top: 10rpx;
}

.intro-description {
    color: #edf3f0;
    font-size: 26rpx;
    line-height: 1.65;
    margin-top: 10rpx;
}

.preview-card {
    background: #fffdf8;
    box-shadow: 0 8rpx 28rpx rgba(47, 39, 27, 0.08);
    margin-top: 18rpx;
    padding: 24rpx;
}

.preview-heading,
.price-row,
.optional-toggle {
    align-items: center;
    display: flex;
    justify-content: space-between;
}

.preview-title {
    color: #263e37;
    font-size: 30rpx;
    font-weight: 700;
}

.preview-subtitle {
    color: #6f7b76;
    font-size: 23rpx;
    margin-top: 4rpx;
}

.demo-badge {
    background: #f2e5c9;
    color: #71552d;
    font-size: 21rpx;
    padding: 9rpx 15rpx;
}

.preview-stage {
    background: radial-gradient(circle at 50% 50%, #fffdf8 0%, #eee4d4 100%);
    height: 540rpx;
    margin-top: 18rpx;
    overflow: hidden;
    position: relative;
}

.preview-layer {
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
}

.chain-layer {
    z-index: 1;
}

.pendant-group {
    height: 154rpx;
    left: 50%;
    position: absolute;
    top: 358rpx;
    transform: translateX(-50%);
    width: 154rpx;
    z-index: 3;
}

.pearl-layer {
    height: 154rpx;
    position: absolute;
    width: 154rpx;
}

.pearl-primary {
    left: 0;
    top: 0;
}

.pearl-secondary {
    height: 112rpx;
    left: 96rpx;
    top: 36rpx;
    width: 112rpx;
}

.pendant-group.double {
    margin-left: -40rpx;
}

.pendant-group.small .pearl-layer {
    transform: scale(0.82);
    transform-origin: 50% 12%;
}

.pendant-group.large .pearl-layer {
    transform: scale(1.12);
    transform-origin: 50% 12%;
}

.gem-layer {
    height: 54rpx;
    left: 50rpx;
    position: absolute;
    top: -6rpx;
    width: 54rpx;
    z-index: 4;
}

.selected-line {
    background: #f2eadc;
    color: #3f504a;
    font-size: 24rpx;
    line-height: 1.55;
    margin-top: 16rpx;
    padding: 18rpx;
}

.preview-disclaimer {
    color: #776f64;
    font-size: 21rpx;
    line-height: 1.55;
    margin-top: 12rpx;
}

.price-row {
    border-top: 1rpx solid #e8dfd1;
    margin-top: 18rpx;
    padding-top: 20rpx;
}

.price-label {
    color: #4c5e57;
    font-size: 24rpx;
    font-weight: 600;
}

.price-note {
    color: #8b847b;
    font-size: 20rpx;
    margin-top: 5rpx;
}

.price {
    color: #8c5d27;
    font-family: serif;
    font-size: 48rpx;
    font-weight: 700;
}

.config-state {
    background: #fffdf8;
    border-left: 6rpx solid #b98545;
    margin-top: 18rpx;
    padding: 25rpx;
}

.config-state.error {
    border-left-color: #b9574d;
}

.config-state-title {
    color: #2a3e38;
    font-size: 28rpx;
    font-weight: 700;
}

.config-state-description {
    color: #69756f;
    font-size: 24rpx;
    line-height: 1.55;
    margin-top: 8rpx;
}

.config-retry {
    background: #183d35;
    border-radius: 4rpx;
    color: #fff;
    font-size: 25rpx;
    margin: 18rpx 0 0;
    width: 210rpx;
}

.section {
    background: #fffdf8;
    margin-top: 18rpx;
    padding: 28rpx 22rpx;
}

.section-heading {
    align-items: flex-start;
    display: flex;
    gap: 18rpx;
    margin-bottom: 22rpx;
}

.section-heading.compact {
    margin-bottom: 18rpx;
}

.section-heading-text {
    flex: 1;
}

.section-step {
    align-items: center;
    background: #183d35;
    border-radius: 50%;
    color: #fff;
    display: flex;
    flex: 0 0 52rpx;
    font-size: 26rpx;
    height: 52rpx;
    justify-content: center;
    width: 52rpx;
}

.section-title {
    color: #203a33;
    font-size: 32rpx;
    font-weight: 700;
}

.section-description {
    color: #68756f;
    font-size: 23rpx;
    line-height: 1.55;
    margin-top: 7rpx;
}

.option-grid {
    display: grid;
    gap: 14rpx;
    grid-template-columns: 1fr 1fr;
}

.option {
    background: #faf7f1;
    border: 3rpx solid #ded7ca;
    box-sizing: border-box;
    min-height: 190rpx;
    padding: 18rpx 16rpx;
    position: relative;
    text-align: center;
}

.option.selected {
    background: #fff8e9;
    border-color: #b98545;
}

.option-check {
    align-items: center;
    background: #183d35;
    border-radius: 50%;
    color: #fff;
    display: flex;
    font-size: 20rpx;
    height: 34rpx;
    justify-content: center;
    position: absolute;
    right: 10rpx;
    top: 10rpx;
    width: 34rpx;
}

.option:not(.selected) .option-check {
    background: transparent;
    border: 2rpx solid #c5bdae;
    box-sizing: border-box;
}

.option-image,
.option-none-mark {
    height: 74rpx;
    margin: 0 auto 10rpx;
    width: 74rpx;
}

.option-none-mark {
    align-items: center;
    border: 2rpx solid #a9a092;
    border-radius: 50%;
    color: #675f55;
    display: flex;
    font-size: 34rpx;
    justify-content: center;
}

.option-name {
    color: #263c35;
    font-size: 25rpx;
    font-weight: 600;
    line-height: 1.42;
}

.option-price {
    color: #8c6536;
    font-size: 22rpx;
    margin-top: 7rpx;
}

.optional-toggle {
    background: #e9dec9;
    margin-top: 20rpx;
    padding: 25rpx 22rpx;
}

.optional-toggle-title {
    color: #2b423a;
    font-size: 29rpx;
    font-weight: 700;
}

.optional-toggle-description {
    color: #6c716d;
    font-size: 22rpx;
    line-height: 1.5;
    margin-top: 6rpx;
}

.optional-toggle-icon {
    color: #865d2e;
    flex: 0 0 70rpx;
    font-size: 24rpx;
    text-align: right;
}

.optional-panel,
.optional-section {
    margin-top: 0;
}

.optional-mark {
    color: #856741;
    font-size: 21rpx;
    font-weight: 400;
    margin-left: 8rpx;
}

.engraving {
    background: #faf7f1;
    border: 2rpx solid #d5cbbc;
    box-sizing: border-box;
    color: #263c35;
    font-size: 26rpx;
    height: 92rpx;
    line-height: 92rpx;
    padding: 0 20rpx;
    width: 100%;
}

.bottom-bar {
    background: rgba(255, 253, 248, 0.97);
    bottom: 0;
    box-shadow: 0 -6rpx 24rpx rgba(45, 38, 28, 0.09);
    display: flex;
    gap: 14rpx;
    left: 0;
    padding: 18rpx 22rpx 24rpx;
    position: fixed;
    right: 0;
    z-index: 20;
}

.bottom-bar button {
    border-radius: 6rpx;
    flex: 1;
    font-size: 29rpx;
    font-weight: 600;
    height: 88rpx;
    line-height: 88rpx;
    margin: 0;
}

.secondary {
    background: #fffdf8;
    border: 2rpx solid #87643a;
    color: #694a27;
}

.primary {
    background: #183d35;
    color: #fff;
}
.reference-card {
    margin: 24rpx;
    padding: 28rpx;
    background: #fff;
    border-radius: 24rpx;
}
.reference-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #274c3e;
}
.reference-note {
    margin-top: 16rpx;
    font-size: 24rpx;
    line-height: 1.7;
    color: #66736b;
    overflow-wrap: anywhere;
}
.reference-fields {
    display: flex;
    flex-wrap: wrap;
    margin: 20rpx -8rpx;
}
.reference-fields label {
    box-sizing: border-box;
    flex: 1;
    min-width: 180rpx;
    margin: 8rpx;
    font-size: 24rpx;
    color: #4c5d53;
}
.reference-fields input {
    margin-top: 10rpx;
    padding: 16rpx;
    background: #f5f7f4;
    border-radius: 10rpx;
    font-size: 28rpx;
}
.reference-preference {
    padding: 20rpx 0;
    font-size: 28rpx;
    border-bottom: 1rpx solid #e8ede7;
}
.reference-preference text {
    float: right;
    color: #687e6d;
}

.reference-action {
    margin-top: 12rpx;
    background: #315c4b;
    color: #fff;
    font-size: 28rpx;
    border-radius: 14rpx;
}
.reference-action[disabled] {
    background: #e6ebe6;
    color: #8a958c;
}
.reference-result {
    margin-top: 24rpx;
    padding-top: 24rpx;
    border-top: 1rpx solid #e8ede7;
}
.reference-length {
    font-size: 32rpx;
    font-weight: 600;
    color: #274c3e;
}
.reference-reason {
    margin-top: 18rpx;
    font-size: 28rpx;
    line-height: 1.7;
    color: #394a40;
}

/* 为手势区保留操作栏空间, 内容仍可完整滚动到最后一项. */
.page {
    padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}
.bottom-bar {
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.necklace-stage {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    background: #faf8f3;
    border-radius: 24rpx;
    overflow: hidden;
}
.necklace-guide {
    position: absolute;
    left: 11%;
    top: 13%;
    width: 78%;
    height: 74%;
    border: 1px dashed #d5c6af;
    border-radius: 50%;
}
.necklace-node {
    position: absolute;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    box-sizing: border-box;
}
.pearl-node {
    background: radial-gradient(circle at 32% 28%, #fff 6%, #f2e9d8 60%, #bdad91 100%);
    border: 1rpx solid #beaf97;
}
.part-node {
    background: #9b784b;
    border-radius: 25%;
}
.active-node {
    outline: 4rpx solid #315c4b;
    outline-offset: 4rpx;
}
.necklace-empty {
    position: absolute;
    top: 48%;
    width: 100%;
    text-align: center;
    color: #8c8273;
}
.arrangement-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin: 24rpx 0;
}
.arrangement-tools button {
    margin: 0;
}
.instance-strip {
    white-space: nowrap;
    width: 100%;
    margin-bottom: 18rpx;
}
.instance-chip {
    display: inline-block;
    padding: 15rpx;
    margin-right: 10rpx;
    background: #f5f2eb;
    border: 2rpx solid transparent;
    border-radius: 12rpx;
    font-size: 23rpx;
}
.chosen-chip {
    border-color: #315c4b;
    color: #315c4b;
}
.bom-line {
    font-size: 24rpx;
    color: #60574a;
    margin: 10rpx 0;
}
.copy-count {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12rpx;
    font-size: 24rpx;
    color: #6c6356;
    margin-bottom: 22rpx;
}
.copy-count input {
    width: 100rpx;
    padding: 12rpx;
    background: #f5f2eb;
    border-radius: 8rpx;
}

.sizing-section input {
    height: 88rpx;
    line-height: 88rpx;
    margin: 16rpx 0;
    padding: 0 20rpx;
    background: #f5f2eb;
    border-radius: 12rpx;
}

.sizing-section {
    margin: 24rpx;
    overflow-wrap: anywhere;
}
