<view class="container">
    <view class="collect-list">
        <view class="item" bindtap="openGoods"  bindtouchstart="touchStart" bindtouchend="touchEnd" wx:for="{{collectList}}" wx:key="id" data-index="{{index}}">
            <image class="img" src="{{item.listPicUrl}}" webp="{{true}}"></image>
            <view class="info">
                <view class="name">{{item.name}}</view>
                <view class="subtitle">{{item.goodsBrief}}</view>
                <view class="price">￥{{item.retailPrice}}</view>
            </view>
        </view>
    </view>
    <view class="empty-state" wx:if="{{collectList.length === 0}}">
        <view class="empty-icon">♡</view>
        <view class="empty-title">暂无收藏</view>
        <view class="empty-desc">遇到喜欢的珠宝，可以先收藏起来</view>
        <navigator class="empty-action" url="/pages/index/index" open-type="switchTab">快去逛逛</navigator>
    </view>
</view>

<merchant-contact />
