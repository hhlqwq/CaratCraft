<view class="container">
    <view class="footprint">
        <view class="day-item" wx:for="{{footprintList}}" wx:key="index">
            <view class="day-hd">{{item[0].addTime}}</view>
            <view class="day-list">
                <view class="item" data-footprint="{{iitem}}" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtap="deleteItem" wx:for="{{item}}"  wx:for-item="iitem" wx:key="id">
                    <image class="img" src="{{iitem.listPicUrl}}" webp="{{true}}"></image>
                    <view class="info">
                        <view class="name">{{iitem.name}}</view>
                        <view class="subtitle">{{iitem.goodsBrief}}</view>
                        <view class="price">￥{{iitem.retailPrice}}</view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <view class="empty-state" wx:if="{{loading && footprintList.length === 0}}">
        <view class="empty-title">正在加载浏览足迹...</view>
    </view>
    <view class="empty-state" wx:if="{{error && !loading}}">
        <view class="empty-title">{{error}}</view>
        <view class="empty-action" bindtap="onPullDownRefresh">重试</view>
    </view>
    <view class="empty-state" wx:if="{{!loading && !error && footprintList.length === 0}}">
        <view class="empty-icon">◇</view>
        <view class="empty-title">暂无浏览足迹</view>
        <view class="empty-desc">浏览珠宝商品后，这里会留下记录</view>
        <navigator class="empty-action" url="/pages/index/index" open-type="switchTab">去逛逛</navigator>
    </view>
    <view class="empty-state" wx:if="{{!loading && !error && footprintList.length > 0 && !hasMore}}">
        <view class="empty-desc">没有更多足迹了</view>
    </view>
</view>

<merchant-contact />
