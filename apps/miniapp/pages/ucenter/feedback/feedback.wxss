@import "../../../styles/service-form.wxss";
.feedback-types {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}
.feedback-type {
    margin: 0;
    padding: 0 19rpx;
    color: #45534b;
    background: #f8f6f0;
    border: 1rpx solid #d9d5ca;
    border-radius: 10rpx;
    font-size: 24rpx;
    line-height: 60rpx;
}
.feedback-type-selected {
    color: #244436;
    background: #e8efe8;
    border-color: #6b8976;
    font-weight: 600;
}
.service-textarea {
    display: block;
    height: 232rpx;
    padding: 18rpx 20rpx;
    line-height: 1.5;
}
.feedback-count {
    margin-top: 8rpx;
    color: #67746a;
    font-size: 22rpx;
    text-align: right;
}
