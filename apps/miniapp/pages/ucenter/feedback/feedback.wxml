<view class="service-form">
    <view class="service-title">意见反馈</view>
    <view class="service-description">反馈仅向商家处理人员可见。</view>
    <view class="service-card">
        <view class="service-field">
            <text class="service-label">反馈类型 *</text>
            <view class="feedback-types">
                <block wx:for="{{array}}" wx:key="*this" wx:for-index="typeIndex">
                    <button wx:if="{{typeIndex > 0}}" class="feedback-type {{index === typeIndex ? 'feedback-type-selected' : ''}}"
                            bindtap="selectFeedbackType" data-type="{{typeIndex}}" disabled="{{actionBusy}}">{{item}}</button>
                </block>
            </view>
        </view>
        <view class="service-field">
            <text class="service-label">反馈内容 *</text>
            <textarea class="service-textarea" disabled="{{actionBusy}}" value="{{content}}" maxlength="500"
                      bindinput="contentInput" placeholder="请描述遇到的问题或希望改进的地方"
                      placeholder-class="service-placeholder" />
            <view class="feedback-count">{{contentLength}} / 500</view>
        </view>
        <view class="service-field">
            <text class="service-label">联系电话（选填）</text>
            <input class="service-input" type="number" maxlength="11" disabled="{{actionBusy}}" value="{{mobile}}"
                   bindinput="mobileInput" placeholder="希望收到回复时填写" placeholder-class="service-placeholder" />
        </view>
    </view>
    <button class="service-action" bindtap="submitFeedback" disabled="{{actionBusy}}" loading="{{actionBusy}}">提交反馈</button>
</view>
