<view class="catalog-page">
    <view class="intro" wx:if="{{isStoreHome}}">
        <text class="title">CaratCraft</text>
        <navigator class="search" url="/pages/search/search">搜索珠宝</navigator>
    </view>
    <swiper wx:if="{{promotions.length}}" class="promotion" indicator-dots="{{promotions.length > 1}}" circular="{{promotions.length > 1}}">
        <swiper-item wx:for="{{promotions}}" wx:key="id">
            <navigator wx:if="{{item.productPath}}" url="{{item.productPath}}">
                <image class="promotion-image" src="{{item.imageUrl}}" mode="aspectFill" aria-label="{{item.name}}" />
            </navigator>
            <image wx:else class="promotion-image" src="{{item.imageUrl}}" mode="aspectFill" aria-label="{{item.name}}" />
        </swiper-item>
    </swiper>
    <view class="filters">
        <view class="filter-row source-row">
            <button wx:for="{{sources}}" wx:key="id" class="chip {{source === item.id ? 'selected' : ''}}"
                    data-field="source" data-id="{{item.id}}" bindtap="selectFilter">{{item.name}}</button>
        </view>
        <view class="filter-row">
            <button wx:for="{{types}}" wx:key="id" class="chip {{type === item.id ? 'selected' : ''}}"
                    data-field="type" data-id="{{item.id}}" bindtap="selectFilter">{{item.name}}</button>
        </view>
    </view>
    <view class="product-grid">
        <navigator wx:for="{{goods}}" wx:key="id" class="product-card" url="/pages/goods/goods?id={{item.id}}">
            <image wx:if="{{item.listPicUrl || item.primaryPicUrl}}" class="product-image"
                    src="{{item.listPicUrl || item.primaryPicUrl}}" mode="aspectFill" lazy-load="{{true}}" />
            <view wx:else class="product-image image-pending">待上传图片</view>
            <view class="product-copy">
                <text class="product-name">{{item.name}}</text>
                <text wx:if="{{item.goodsBrief}}" class="product-description">{{item.goodsBrief}}</text>
                <text class="price">¥ {{item.retailPrice}}</text>
            </view>
        </navigator>
    </view>
    <view wx:if="{{loading}}" class="status" role="status">正在加载商品…</view>
    <view wx:elif="{{error}}" class="status" role="alert"><text>{{error}}</text><button class="retry" bindtap="loadMore">重试</button></view>
    <view wx:elif="{{!goods.length}}" class="status">当前分类暂无在售商品</view>
    <button wx:elif="{{hasMore}}" class="more" bindtap="loadMore">加载更多</button>
</view>

<merchant-contact />
