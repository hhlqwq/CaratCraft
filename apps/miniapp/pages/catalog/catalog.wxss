page {
    background: #f8f6f3;
    color: #292337;
}

.catalog-page {
    padding: 28rpx 26rpx calc(32rpx + env(safe-area-inset-bottom));
}

.intro {
    align-items: center;
    display: flex;
    gap: 24rpx;
    justify-content: space-between;
    margin-bottom: 26rpx;
}

.title {
    font-family: Georgia, serif;
    font-size: 43rpx;
    line-height: 1.15;
}

.search {
    background: #fff;
    border: 1rpx solid #e6e0e8;
    border-radius: 14rpx;
    color: #665a70;
    flex: 1;
    font-size: 25rpx;
    padding: 15rpx 22rpx;
}

.promotion {
    border-radius: 18rpx;
    height: 286rpx;
    margin-bottom: 24rpx;
    overflow: hidden;
}

.promotion navigator,
.promotion-image {
    display: block;
    height: 100%;
    width: 100%;
}

.filters {
    margin-bottom: 24rpx;
}

.filter-row {
    display: flex;
    gap: 12rpx;
    margin-top: 14rpx;
}

.chip {
    background: #fff;
    border: 1rpx solid #e6e0e8;
    border-radius: 12rpx;
    color: #665a70;
    flex: 1;
    font-size: 25rpx;
    line-height: 66rpx;
    margin: 0;
    min-width: 0;
    padding: 0 4rpx;
}

.source-row .chip {
    font-size: 28rpx;
    line-height: 78rpx;
}

.chip.selected {
    background: #eee6f0;
    border-color: #c5aecf;
    color: #4d345b;
    font-weight: 600;
}

.chip::after,
.retry::after,
.more::after {
    border: 0;
}

.product-grid {
    display: grid;
    gap: 18rpx;
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.product-card {
    background: #fff;
    border: 1rpx solid #e6e0e8;
    border-radius: 15rpx;
    overflow: hidden;
}

.product-image {
    display: block;
    height: 300rpx;
    width: 100%;
}

.image-pending {
    align-items: center;
    background: #eeeaf0;
    color: #665a70;
    display: flex;
    font-size: 24rpx;
    justify-content: center;
}

.product-copy {
    display: grid;
    gap: 5rpx;
    padding: 15rpx 17rpx 19rpx;
}

.product-name {
    color: #292337;
    font-size: 27rpx;
    font-weight: 600;
    line-height: 1.4;
}

.product-description,
.status {
    color: #665a70;
    font-size: 23rpx;
}

.product-description {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.price {
    color: #4d345b;
    font-size: 27rpx;
    font-weight: 600;
}

.status {
    padding: 36rpx 16rpx;
    text-align: center;
}

.retry,
.more {
    background: #eee6f0;
    border-radius: 12rpx;
    color: #4d345b;
    font-size: 25rpx;
    margin-top: 20rpx;
}
