<view class="service-form">
    <view class="service-title">绑定手机号</view>
    <view class="service-description">绑定后可完善账号资料。</view>
    <form bindsubmit="bindLoginMobilecode">
        <view class="service-card">
            <view class="service-field">
                <text class="service-label">手机号码</text>
                <input class="service-input" type="number" name="mobile" maxlength="11" value="{{mobile}}"
                       bindinput="bindInputMobile" placeholder="输入 11 位手机号" placeholder-class="service-placeholder"
                       disabled="{{sendingCode || submitting}}" />
            </view>
            <view class="service-field">
                <text class="service-label">短信验证码</text>
                <view class="mobile-code-row">
                    <input class="service-input" type="number" name="code" maxlength="6" value="{{mobileCode}}"
                           bindinput="bindInputCode" placeholder="输入 6 位验证码" placeholder-class="service-placeholder"
                           disabled="{{sendingCode || submitting}}" />
                    <button class="send-code" bindtap="countDownPassCode" loading="{{sendingCode}}"
                            disabled="{{disableGetMobileCode || submitting}}">{{getCodeButtonText}}</button>
                </view>
            </view>
            <view wx:if="{{formError}}" class="mobile-form-error">{{formError}}</view>
        </view>
        <button class="service-action" form-type="submit" loading="{{submitting}}"
                disabled="{{disableSubmitMobileCode || submitting || sendingCode}}">确认绑定</button>
    </form>
</view>
