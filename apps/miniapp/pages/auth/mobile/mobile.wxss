@import "../../../styles/service-form.wxss";
.mobile-code-row {
    display: flex;
    gap: 16rpx;
    align-items: center;
}
.mobile-code-row input { flex: 1; }
.send-code {
    flex: none;
    margin: 0;
    padding: 0 16rpx;
    color: #294d3e;
    background: #fffdf9;
    border: 1rpx solid #abb9ad;
    border-radius: 10rpx;
    font-size: 25rpx;
    line-height: 86rpx;
}
.send-code[disabled] { color: #67746a; background: #edece5; }
.mobile-form-error {
    margin-top: 20rpx;
    color: #923730;
    font-size: 25rpx;
    line-height: 1.5;
}
