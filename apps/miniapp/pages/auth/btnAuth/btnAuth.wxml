<view class="service-form sign-in">
    <view class="sign-in-brand">
        <image class="sign-in-logo" src="/static/images/logo.png" mode="aspectFit" />
        <text>CaratCraft · 克拉匠造</text>
    </view>
    <view class="service-title">登录克拉匠造</view>
    <view class="service-description">登录后可保存自己的设计、查看订单和分享作品。</view>
    <view class="service-card sign-in-card">
        <legal-consent bindchange="consentChanged" />
        <button class="service-action" disabled="{{!legalAcceptance || saving}}" loading="{{saving}}" bindtap="confirmLogin">使用微信登录</button>
    </view>
    <navigator class="guest-entry" open-type="switchTab" url="/pages/index/index">先去逛逛</navigator>
</view>
