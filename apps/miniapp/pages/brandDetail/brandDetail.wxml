<view class="container">
    <view class="brand-info">
        <view class="name">
            <image class="img" src="{{brand.appListPicUrl}}" background-size="cover" webp="{{true}}"></image>
            <view class="info-box">
                <view class="info">
                    <text class="txt">{{brand.name}}</text>
                    <text class="line"></text>
                </view>
            </view>
        </view>
        <view class="desc">
            {{brand.simpleDesc}}
        </view>
    </view>

    <view class="cate-item">
        <view class="b">
            <block wx:for="{{goodsList}}" wx:for-index="iindex" wx:for-item="iitem" wx:key="id">
                <navigator class="item {{iindex % 2 == 0 ? 'item-b' : ''}}" url="../goods/goods?id={{iitem.id}}">
                    <image class="img" src="{{iitem.listPicUrl}}" background-size="cover" webp="{{true}}"></image>
                    <text class="name">{{iitem.name}}</text>
                    <text class="price">￥{{iitem.retailPrice}}</text>
                </navigator>
            </block>
        </view>
    </view>
</view>

<merchant-contact />
