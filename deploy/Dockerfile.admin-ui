FROM m.daocloud.io/docker.io/library/node:24-alpine AS builder

WORKDIR /workspace

RUN npm install --global --registry=https://registry.npmmirror.com pnpm@9.15.9

COPY apps/admin-ui/package.json apps/admin-ui/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/pnpm/store,sharing=locked pnpm install --store-dir=/pnpm/store --registry=https://registry.npmmirror.com --frozen-lockfile --ignore-scripts

COPY apps/admin-ui/index.html apps/admin-ui/vite.config.mjs ./
COPY apps/admin-ui/src/ ./src/
COPY apps/admin-ui/static/ ./static/
COPY legal/ /legal/
RUN pnpm run build

FROM m.daocloud.io/docker.io/library/nginx:1.27-alpine
ARG BUILD_VERSION=0.1.0
LABEL org.opencontainers.image.version=${BUILD_VERSION}
ARG BUILD_REVISION=workspace
ARG BUILD_GIT_SHA=archive
LABEL org.opencontainers.image.revision=${BUILD_GIT_SHA} io.caratcraft.source-digest=${BUILD_REVISION}

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/dist/ /usr/share/nginx/html/
COPY apps/miniapp/static/images/ /usr/share/nginx/html/static/images/
COPY legal/ /usr/share/nginx/html/legal/

EXPOSE 80

COPY release.json /usr/share/nginx/html/release.json
