FROM m.daocloud.io/docker.io/library/maven:3.9.11-eclipse-temurin-21 AS builder

WORKDIR /workspace/backend

COPY backend/pom.xml ./
COPY backend/platform-common/pom.xml platform-common/pom.xml
COPY backend/platform-biz/pom.xml platform-biz/pom.xml
COPY backend/platform-admin/pom.xml platform-admin/pom.xml
COPY backend/platform-api/pom.xml platform-api/pom.xml
COPY backend/platform-common/src/main platform-common/src/main
COPY backend/platform-biz/src/main platform-biz/src/main
COPY backend/platform-admin/src/main platform-admin/src/main
COPY backend/platform-api/src/main platform-api/src/main
COPY deploy/maven-settings.xml /workspace/maven-settings.xml

RUN --mount=type=cache,target=/root/.m2/repository,sharing=locked mvn -B -s /workspace/maven-settings.xml -Pdev -pl platform-admin,platform-api -am package -Dmaven.test.skip=true
COPY deploy/HealthCheck.java /workspace/healthcheck/HealthCheck.java
RUN javac -d /workspace/healthcheck /workspace/healthcheck/HealthCheck.java

FROM m.daocloud.io/docker.io/library/eclipse-temurin:21-jre
ARG BUILD_REVISION=workspace
ARG BUILD_GIT_SHA=archive
ENV BUILD_REVISION=${BUILD_REVISION} BUILD_GIT_SHA=${BUILD_GIT_SHA}
LABEL org.opencontainers.image.revision=${BUILD_GIT_SHA} io.caratcraft.source-digest=${BUILD_REVISION}

WORKDIR /app

RUN groupadd --system caratcraft \
    && useradd --system --gid caratcraft --home-dir /app caratcraft \
    && mkdir -p /data/uploads \
    && chown -R caratcraft:caratcraft /app /data/uploads

COPY --from=builder --chown=caratcraft:caratcraft \
    /workspace/backend/platform-admin/target/platform-admin.jar /app/platform-admin.jar
COPY --from=builder --chown=caratcraft:caratcraft \
    /workspace/backend/platform-api/target/platform-api.jar /app/platform-api.jar
COPY --chown=caratcraft:caratcraft legal/ /app/legal/
COPY --from=builder --chown=caratcraft:caratcraft /workspace/healthcheck/HealthCheck.class /app/healthcheck/HealthCheck.class

USER caratcraft

EXPOSE 8080 8081
