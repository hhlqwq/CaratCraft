TZ=Asia/Shanghai
# 小程序开发版使用 local 或 lan. production 仅用于发布配置生成及诊断.
CARATCRAFT_ENV=local
MINIAPP_LOCAL_ORIGIN=
MINIAPP_LAN_ORIGIN=
MINIAPP_TRIAL_ORIGIN=
MINIAPP_PRODUCTION_ORIGIN=
MAVEN_PROFILE=dev
NGINX_PORT=8888
MYSQL_PORT=3306
REDIS_PORT=6379
MYSQL_DATABASE=platform
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=caratcraft
MYSQL_APP_PASSWORD=
REDIS_PASSWORD=
PLATFORM_ADMIN_JAVA_OPTS=-Xms256m -Xmx512m
PLATFORM_API_JAVA_OPTS=-Xms256m -Xmx512m

# 微信小程序配置
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
# 微信公众号配置
WX_MP_APPID=
WX_MP_SECRET=
WX_MP_TOKEN=
WX_MP_AESKEY=
# 微信小程序消息配置
WX_MINIAPP_TOKEN=
WX_MINIAPP_AESKEY=
# 微信支付配置
WX_PAY_APPID=
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_MERCHANT_SERIAL_NUMBER=
WX_PAY_PUBLIC_KEY_ID=
WX_PAY_NOTIFY_URL=
WX_PAY_PRIVATE_KEY_PATH=/run/secrets/apiclient_key.pem
WX_PAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay_public_key.pem
# 商户私钥及微信支付公钥放在deploy/secrets, 路径见该目录说明.
WX_PAY_NOTIFY_IP_WHITELIST_ENABLED=true
WX_PAY_NOTIFY_IP_WHITELIST=101.226.62.0/24,101.226.103.0/24,101.226.233.0/24,101.227.97.0/24,101.227.169.0/24,121.51.30.0/24,140.206.219.0/24,157.255.119.0/24,162.62.182.0/24,162.62.183.0/24
# 工作室员工及新商城业务的归属, 填写已经启用的机构编码.
CARATCRAFT_DEFAULT_BUSINESS_ORG=
# JWT密钥必须为至少32字节随机数的Base64编码, 不可留空.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# JWT 密钥
JWT_SECRET=


# 浏览器跨域来源白名单, 逗号分隔; 同源部署留空.
APP_CORS_ALLOWED_ORIGINS=

# 员工密码找回渠道, 按实际发送渠道启用.
CARATCRAFT_STAFF_RECOVERY_EMAIL_ENABLED=false
CARATCRAFT_STAFF_RECOVERY_SMS_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
