page,
.container {
  background: #f1f3ef;
  min-height: 100%;
}

.container {
  overflow: hidden;
  padding-bottom: 128rpx;
}

.no-cart .c {
  min-height: 620rpx;
}

.title-box {
  background: none;
  color: #25312c;
  margin: 0;
  padding: 0;
}

.title-box::before {
  border: 2rpx solid #baa47c;
  border-radius: 50%;
  color: #9d7a42;
  content: '空';
  display: block;
  font-family: serif;
  font-size: 46rpx;
  line-height: 130rpx;
  margin: 0 auto 28rpx;
  text-align: center;
  width: 130rpx;
}

.to-index-btn {
  background: #9a713b;
  font-size: 25rpx;
  line-height: 76rpx;
  margin-top: 36rpx;
  text-align: center;
  width: 260rpx;
}

.cart-view {
  padding: 22rpx;
}

.cart-view .list {
  margin-bottom: 110rpx;
}

.cart-view .group-item {
  background: transparent;
}

.cart-view .item {
  align-items: center;
  background: #fff;
  display: flex;
  margin-bottom: 16rpx;
  min-height: 210rpx;
  padding: 20rpx;
}

.cart-view .item .checkbox,
.cart-bottom .checkbox::before {
  border: 2rpx solid #a9afa9;
  border-radius: 50%;
  height: 34rpx;
  margin-right: 18rpx;
  width: 34rpx;
}

.cart-view .item .checkbox.checked,
.cart-bottom .checkbox.checked::before {
  background: #9b713a;
  border-color: #9b713a;
  box-shadow: inset 0 0 0 7rpx #fff;
}

.cart-view .item .cart-goods {
  display: flex;
  flex: 1;
  min-width: 0;
}

.cart-view .item .img {
  background: #eeece7;
  height: 154rpx;
  width: 154rpx;
}

.cart-view .item .info {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.cart-view .item .t,
.cart-view .item .b {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.cart-view .item .name {
  color: #26312d;
  font-family: serif;
  font-size: 27rpx;
  font-weight: 600;
  max-width: 330rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-view .item .num,
.cart-view .item .attr {
  color: #8f887e;
  font-size: 21rpx;
}

.cart-view .item .attr {
  margin: 16rpx 0 24rpx;
}

.cart-view .item .price {
  color: #9c7138;
  font-family: serif;
  font-size: 29rpx;
}

.cart-view .item .selnum {
  align-items: center;
  border: 1rpx solid #d8d4cc;
  display: none;
  height: 54rpx;
  width: 210rpx;
}

.cart-view .item.edit .t {
  display: none;
}

.cart-view .item.edit .selnum {
  display: flex;
}

.cart-view .item.edit .attr {
  margin-bottom: 12rpx;
  text-align: right;
}

.selnum .cut,
.selnum .add {
  line-height: 52rpx;
  text-align: center;
  width: 62rpx;
}

.selnum .number {
  border-left: 1rpx solid #ddd8cf;
  border-right: 1rpx solid #ddd8cf;
  flex: 1;
  height: 52rpx;
  text-align: center;
}

.cart-bottom {
  align-items: center;
  background: #fff;
  border-top: 1rpx solid #dedad2;
  bottom: 0;
  display: flex;
  left: 0;
  min-height: 112rpx;
  padding-left: 24rpx;
  position: fixed;
  right: 0;
  z-index: 10;
}

.cart-bottom .checkbox {
  align-items: center;
  color: #555f5a;
  display: flex;
  font-size: 22rpx;
}

.cart-bottom .checkbox::before {
  content: '';
  display: block;
}

.cart-bottom .total {
  color: #9c7138;
  flex: 1;
  font-family: serif;
  font-size: 31rpx;
  padding-left: 16rpx;
}

.cart-bottom .delete {
  color: #6f7772;
  font-size: 22rpx;
  padding: 0 22rpx;
}

.cart-bottom .checkout {
  align-items: center;
  align-self: stretch;
  background: #24352f;
  color: #fff;
  display: flex;
  font-size: 27rpx;
  justify-content: center;
  width: 190rpx;
}
