.community-page {
    padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
    background: #f6f4ef;
    min-height: 100vh;
    box-sizing: border-box;
    color: #302f29;
}
.community-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20rpx;
    margin-bottom: 22rpx;
}
.community-heading button {
    margin: 0;
    flex-shrink: 0;
    background: #315c4b;
    color: #fff;
}
.eyebrow {
    color: #8b785d;
    font-size: 22rpx;
    letter-spacing: 4rpx;
}
.page-title {
    font-size: 42rpx;
    font-weight: 600;
    margin-top: 10rpx;
}
.community-note,
.post-meta,
.post-footer,
.design-summary {
    color: #817a6e;
    font-size: 23rpx;
    line-height: 1.7;
}
.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin: 28rpx 0;
}
.filter {
    padding: 14rpx 22rpx;
    background: #fff;
    border-radius: 30rpx;
    font-size: 25rpx;
}
.filter.selected {
    color: #fff;
    background: #315c4b;
}
.post-card,
.empty {
    background: #fff;
    padding: 28rpx;
    margin-bottom: 24rpx;
    border-radius: 20rpx;
    box-shadow: 0 8rpx 30rpx #332c1c05;
}
.post-title,
.empty-title {
    font-size: 32rpx;
    font-weight: 600;
    margin: 12rpx 0 18rpx;
    overflow-wrap: anywhere;
}
.post-content {
    font-size: 28rpx;
    line-height: 1.85;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}
.post-images {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
    margin-top: 20rpx;
}
.post-images image {
    width: 30%;
    height: 180rpx;
    border-radius: 12rpx;
    background: #f4f1eb;
}
.post-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: 22rpx;
}
.post-footer button {
    margin: 0;
    font-size: 23rpx;
}
.post-footer text {
    flex: 1;
    min-width: 200rpx;
}
.moderation-note {
    padding: 16rpx;
    margin-top: 20rpx;
    background: #faf3e5;
    font-size: 25rpx;
    color: #86622f;
}
.state,
.empty,
.end-note {
    text-align: center;
    color: #817a6e;
    font-size: 25rpx;
    padding: 40rpx 20rpx;
    line-height: 1.8;
}
.state button,
.empty button {
    margin-top: 24rpx;
}
.design-summary {
    margin-top: 20rpx;
}
.public-necklace {
    position: relative;
    width: 360rpx;
    height: 360rpx;
    margin: 20rpx auto;
    background: #faf8f3;
    border-radius: 18rpx;
}
.public-guide {
    position: absolute;
    left: 11%;
    top: 13%;
    width: 78%;
    height: 74%;
    border: 1rpx dashed #d5c6af;
    border-radius: 50%;
}
.public-node {
    position: absolute;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    box-sizing: border-box;
}
.public-pearl {
    background: radial-gradient(circle at 32% 28%, #fff 6%, #f2e9d8 60%, #bdad91 100%);
    border: 1rpx solid #beaf97;
}
.public-part {
    background: #9b784b;
    border-radius: 25%;
}
