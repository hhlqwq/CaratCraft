.legal-page {
  padding: 32rpx 32rpx 200rpx;
  background: #fffdf8;
  min-height: 100vh;
  color: #183d35;
}
.title {
  font-size: 34rpx;
  margin: 28rpx 0;
  font-weight: 600;
}
.document {
  padding-bottom: 36rpx;
  border-bottom: 1rpx solid #ddd;
}
.content {
  display: block;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.8;
  margin-top: 24rpx;
}
navigator {
  padding: 16rpx 0;
  font-size: 26rpx;
  text-decoration: underline;
}
