page {
  background: #eee9df;
  min-height: 100%;
}

.container {
  background: #eee9df;
  min-height: 100vh;
  padding-bottom: 42rpx;
}

.header {
  background: #17231f;
  padding: 48rpx 30rpx 76rpx;
  position: relative;
}

.header::after {
  color: rgba(205, 176, 118, 0.1);
  content: 'CC';
  font-family: serif;
  font-size: 190rpx;
  position: absolute;
  right: 14rpx;
  top: -20rpx;
}

.profile-btn {
  align-items: center;
  background: transparent;
  border: 0;
  display: flex;
  line-height: normal;
  padding: 0;
  position: relative;
  text-align: left;
  width: 100%;
  z-index: 1;
}

.avatar {
  border: 4rpx solid #c5a76c;
  border-radius: 50%;
  height: 126rpx;
  padding: 6rpx;
  width: 126rpx;
}

.meta {
  margin-left: 26rpx;
}

.nickname {
  color: #fff;
  font-family: serif;
  font-size: 38rpx;
  font-weight: 600;
}

.nickname::after {
  color: #c6a86c;
  content: '编辑资料 →';
  display: block;
  font-family: sans-serif;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  margin-top: 12rpx;
}

.menu-card {
  background: #fff;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin: -38rpx 24rpx 0;
  position: relative;
  z-index: 2;
}

.menu-item {
  align-items: center;
  background: #fff;
  border: 0;
  border-bottom: 1rpx solid #e5dfd5;
  display: flex;
  height: 124rpx;
  margin: 0;
  padding: 0 22rpx;
  position: relative;
  text-align: left;
}

.menu-item:nth-child(odd) {
  border-right: 1rpx solid #e5dfd5;
}

.menu-item::after {
  border: 0;
  color: #b1a99d;
  content: '›';
  font-size: 34rpx;
  position: absolute;
  right: 18rpx;
}

.icon-badge {
  align-items: center;
  background: #edf0eb;
  border-radius: 50%;
  color: #486157;
  display: flex;
  font-family: serif;
  font-size: 25rpx;
  height: 58rpx;
  justify-content: center;
  width: 58rpx;
}

.menu-item:nth-child(4n + 2) .icon-badge,
.menu-item:nth-child(4n + 3) .icon-badge {
  background: #f1e8da;
  color: #926a39;
}

.txt {
  color: #37423d;
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 16rpx;
}

.company {
  color: #8a8278;
  font-size: 20rpx;
  margin-top: 34rpx;
  text-align: center;
}

.logout {
  border-bottom: 1rpx solid #c9c1b5;
  color: #99645b;
  font-size: 24rpx;
  margin: 28rpx auto 0;
  padding: 14rpx 4rpx;
  text-align: center;
  width: 150rpx;
}

.profile-mask {
  background: rgba(12, 20, 17, 0.68);
  bottom: 0;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 20;
}

.profile-editor {
  background: #fbfaf7;
  left: 36rpx;
  padding: 40rpx 34rpx 34rpx;
  position: fixed;
  right: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 21;
}

.profile-editor-title {
  color: #24312c;
  font-family: serif;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
}

.avatar-picker {
  background: transparent;
  color: #776f65;
  font-size: 22rpx;
  margin: 28rpx auto 20rpx;
}

.avatar-picker image {
  border: 3rpx solid #c3a368;
  border-radius: 50%;
  display: block;
  height: 126rpx;
  margin: 0 auto 12rpx;
  width: 126rpx;
}

.wechat-profile {
  background: #e8efe9;
  color: #42634f;
  font-size: 23rpx;
  margin-bottom: 20rpx;
}

.nickname-input {
  background: #fff;
  border: 1rpx solid #d8d1c7;
  height: 84rpx;
  padding: 0 22rpx;
}

.profile-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.profile-actions button {
  flex: 1;
  font-size: 25rpx;
  margin: 0;
}

.profile-actions .primary {
  background: #9b713b;
  color: #fff;
}
