@import "../../../styles/account-archive.wxss";

page { background: #f2f5f9; }
.container { padding: 24rpx; }
.empty { margin-top: 160rpx; color: #718096; font-size: 28rpx; text-align: center; }
.design-card { display: flex; margin-bottom: 20rpx; padding: 20rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(16, 34, 59, .08); }
.preview { width: 164rpx; height: 164rpx; border-radius: 12rpx; background: #edf2f7; flex-shrink: 0; }
.content { min-width: 0; margin-left: 20rpx; flex: 1; }
.title { color: #1a2d45; font-size: 30rpx; font-weight: 600; }
.meta { overflow: hidden; margin-top: 12rpx; color: #718096; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.price { margin-top: 10rpx; color: #b47a3f; font-size: 28rpx; }
.actions { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: flex-end; margin-top: 10rpx; }
.actions button { margin: 0; }
.continue { margin: 0; border: 1rpx solid #b47a3f; color: #9b642e; background: #fff; }
.pay { margin: 0; border: 1rpx solid #1f5145; color: #fff; background: #1f5145; }
.arrangement-count { font-size: 23rpx; color: #315c4b; padding: 14rpx 8rpx; }
.arrangement-part { font-size: 21rpx; color: #6c6356; padding: 4rpx 8rpx; }
