<view class="page">
  <view class="product-switcher">
    <view class="product-choice {{activeProductType === item.type ? 'active' : ''}}"
          wx:for="{{designerProducts}}" wx:key="goodsId"
          data-goods-id="{{item.goodsId}}" data-type="{{item.type}}" bindtap="switchProduct">
      <view class="product-choice-name">{{item.name}}</view>
      <view class="product-choice-description">{{item.description}}</view>
    </view>
  </view>

  <view class="preview-card">
    <view class="preview-tabs">
      <view class="preview-tab {{previewMode === '2d' ? 'active' : ''}}"
            data-mode="2d" bindtap="switchPreview">2D 预览</view>
      <view wx:if="{{xrSupported && models3d.length}}" class="preview-tab {{previewMode === '3d' ? 'active' : ''}}"
            data-mode="3d" bindtap="switchPreview">3D 预览</view>
    </view>
    <view class="preview-stage">
      <block wx:if="{{previewMode === '2d'}}">
        <image class="preview-photo" src="{{activePreviewImage.url}}" mode="aspectFit" bindtap="previewCurrentImage"></image>
        <view class="demo-badge">AI 演示效果图</view>
        <view class="zoom-hint" bindtap="previewCurrentImage">点击查看大图</view>
      </block>
      <xr-necklace-viewer wx:else models="{{models3d}}" bind:error="handleXrError" />
    </view>
    <scroll-view wx:if="{{previewMode === '2d'}}" class="preview-gallery" scroll-x="true">
      <view class="preview-thumbnail {{activePreviewIndex === index ? 'active' : ''}}"
            wx:for="{{previewGallery}}" wx:key="key"
            data-index="{{index}}" bindtap="selectPreviewImage">
        <image src="{{item.url}}" mode="aspectFill"></image>
        <view class="preview-thumbnail-name">{{item.name}}</view>
      </view>
    </scroll-view>
    <view wx:if="{{previewMode === '2d'}}" class="preview-disclaimer">图片用于展示材质与款式方向，实际成品以商家确认和最终工艺为准。</view>
    <view wx:if="{{xrFailed}}" class="preview-warning">3D 模型加载失败，当前使用 2D 预览。</view>
    <view class="price-label">预估价格</view>
    <view class="price">¥ {{quote.totalPrice || '--'}}</view>
    <view class="price-note">最终价格以提交订单时的服务端报价为准</view>
  </view>

  <view class="config-state" wx:if="{{loadingConfig}}">
    <view class="config-state-title">正在读取商家配置</view>
    <view class="config-state-description">正在加载当前品类适用的款式、珍珠和升级选项。</view>
  </view>
  <view class="config-state error" wx:elif="{{configError}}">
    <view class="config-state-title">定制选项加载失败</view>
    <view class="config-state-description">{{configError}}</view>
    <button class="config-retry" bindtap="retryLoadConfig">重新加载</button>
  </view>

  <view class="section" wx:for="{{componentGroups}}" wx:for-item="group" wx:key="type">
    <view class="section-heading">
      <text class="section-step">{{group.step}}</text>
      <view>
        <view class="section-title">
          {{group.name}}
          <text class="requirement {{group.required ? 'required' : 'optional'}}">{{group.required ? '必选' : '可选'}}</text>
        </view>
        <view class="section-description">{{group.description}}</view>
      </view>
    </view>
    <scroll-view class="option-scroll" scroll-x="true">
      <view wx:if="{{!group.required}}" class="option option-none {{!group.hasSelection ? 'selected' : ''}}"
            data-type="{{group.type}}" bindtap="clearOptional">
        <view class="option-none-mark">—</view>
        <view class="option-name">保持基础款</view>
        <view class="option-price">不增加费用</view>
      </view>
      <view class="option {{option.selected ? 'selected' : ''}}" wx:for="{{group.options}}" wx:for-item="option" wx:key="id" data-id="{{option.id}}" data-type="{{group.type}}" bindtap="selectOption">
        <image wx:if="{{option.assetUrl}}" class="option-image" src="{{option.assetUrl}}" mode="aspectFit"></image>
        <view class="option-name">{{option.name}}</view>
        <view class="option-price">{{option.priceDelta > 0 ? '+' : ''}}¥{{option.priceDelta}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="section selected-summary" wx:if="{{selectedOptionNames.length > 0}}">
    <view class="section-title">当前设计</view>
    <text class="selected-option" wx:for="{{selectedOptionNames}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="section">
    <view class="section-heading">
      <text class="section-step">{{componentGroups.length + 1}}</text>
      <view>
        <view class="section-title">个性刻字</view>
        <view class="section-description">最多输入 20 个字符，最终效果以商家工艺确认为准。</view>
      </view>
    </view>
    <input class="engraving" maxlength="20" placeholder="请输入姓名、日期或纪念文字" value="{{engraving}}" bindinput="changeEngraving"></input>
  </view>

  <view class="bottom-bar">
    <button class="secondary" bindtap="saveDraft" loading="{{saving}}" disabled="{{loadingConfig || configError || !componentGroups.length}}">保存设计</button>
    <button class="primary" bindtap="submitDesign" loading="{{saving}}" disabled="{{loadingConfig || configError || !quote.totalPrice || saving}}">确认设计</button>
  </view>
</view>
