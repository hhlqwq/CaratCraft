<view class="page">
  <view class="preview-card">
    <view class="preview-tabs">
      <view class="preview-tab {{previewMode === '2d' ? 'active' : ''}}"
            data-mode="2d" bindtap="switchPreview">2D 预览</view>
      <view class="preview-tab {{previewMode === '3d' ? 'active' : ''}}"
            data-mode="3d" bindtap="switchPreview">3D 预览</view>
    </view>
    <view class="preview-stage">
      <block wx:if="{{previewMode === '2d'}}">
        <image class="preview-layer" wx:for="{{selectedLayers}}" wx:key="id" src="{{item.assetUrl}}" mode="aspectFit" style="z-index: {{item.zIndex}}"></image>
        <view wx:if="{{!selectedLayers.length}}" class="preview-placeholder">请选择组件开始设计</view>
      </block>
      <xr-necklace-viewer wx:else models="{{models3d}}" bind:error="handleXrError" />
    </view>
    <view wx:if="{{xrFailed}}" class="preview-warning">3D 模型加载失败，当前使用 2D 预览。</view>
    <view class="price-label">预估价格</view>
    <view class="price">¥ {{quote.totalPrice || '--'}}</view>
    <view class="price-note">最终价格以提交订单时的服务端报价为准</view>
  </view>

  <view class="section" wx:for="{{componentGroups}}" wx:for-item="group" wx:key="type">
    <view class="section-heading">
      <text class="section-step">{{group.step}}</text>
      <view>
        <view class="section-title">{{group.name}}</view>
        <view class="section-description">{{group.description}}</view>
      </view>
    </view>
    <scroll-view class="option-scroll" scroll-x="true">
      <view class="option {{option.selected ? 'selected' : ''}}" wx:for="{{group.options}}" wx:for-item="option" wx:key="id" data-id="{{option.id}}" data-type="{{group.type}}" bindtap="selectOption">
        <image wx:if="{{option.assetUrl}}" class="option-image" src="{{option.assetUrl}}" mode="aspectFit"></image>
        <view class="option-name">{{option.name}}</view>
        <view class="option-price">{{option.priceDelta > 0 ? '+' : ''}}¥{{option.priceDelta}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="section selected-summary" wx:if="{{selectedOptionNames.length > 0}}">
    <view class="section-title">当前设计</view>
    <text class="selected-option" wx:for="{{selectedOptionNames}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="section">
    <view class="section-heading">
      <text class="section-step">{{componentGroups.length + 1}}</text>
      <view>
        <view class="section-title">个性刻字</view>
        <view class="section-description">最多输入 20 个字符，最终效果以商家工艺确认为准。</view>
      </view>
    </view>
    <input class="engraving" maxlength="20" placeholder="请输入姓名、日期或纪念文字" value="{{engraving}}" bindinput="changeEngraving"></input>
  </view>

  <view class="bottom-bar">
    <button class="secondary" bindtap="saveDraft" loading="{{saving}}">保存设计</button>
    <button class="primary" bindtap="submitDesign" loading="{{saving}}" disabled="{{!quote.totalPrice || saving}}">确认设计</button>
  </view>
</view>
