.page {
  background: #141e1b;
  min-height: 100vh;
  padding: 24rpx 22rpx 150rpx;
}

.product-switcher {
  display: grid;
  gap: 12rpx;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 18rpx;
}

.product-choice {
  background: #202d28;
  border: 1rpx solid #34423c;
  color: #9ca7a1;
  padding: 22rpx 18rpx;
}

.product-choice.active {
  background: #c39a59;
  border-color: #c39a59;
  color: #17231f;
}

.product-choice-name {
  font-family: serif;
  font-size: 27rpx;
  font-weight: 600;
}

.product-choice-description {
  font-size: 18rpx;
  line-height: 1.45;
  margin-top: 6rpx;
}

.preview-card {
  background: #e8e1d5;
  padding: 18rpx;
  position: relative;
}

.preview-tabs {
  display: flex;
  position: absolute;
  right: 34rpx;
  top: 34rpx;
  z-index: 10;
}

.preview-tab {
  border-bottom: 1rpx solid rgba(30, 45, 39, .28);
  color: #78817b;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  margin-left: 22rpx;
  padding: 8rpx 2rpx;
}

.preview-tab.active {
  border-bottom-color: #6e4d25;
  color: #5f411f;
  font-weight: 600;
}

.preview-stage {
  background: #f4f1eb;
  height: 580rpx;
  overflow: hidden;
  position: relative;
}

.design-canvas {
  height: 580rpx;
  position: relative;
  width: 100%;
  z-index: 2;
}

.preview-stage::before {
  border: 1rpx solid rgba(149, 122, 78, .24);
  border-radius: 50%;
  content: '';
  height: 410rpx;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 410rpx;
}

.preview-layer {
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}

.preview-placeholder {
  color: #958c7f;
  font-family: serif;
  font-size: 28rpx;
  left: 0;
  position: absolute;
  text-align: center;
  top: 270rpx;
  width: 100%;
}

.preview-warning {
  color: #9f653b;
  font-size: 21rpx;
  margin-top: 12rpx;
}

.price-label {
  color: #837a6e;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  margin-top: 20rpx;
  text-transform: uppercase;
}

.price {
  color: #49341e;
  font-family: serif;
  font-size: 48rpx;
  font-weight: 600;
}

.price-note {
  color: #91887b;
  font-size: 20rpx;
  margin-top: 5rpx;
}

.section {
  border-bottom: 1rpx solid rgba(219, 202, 171, .18);
  padding: 34rpx 4rpx;
}

.config-state {
  background: #202d28;
  border-left: 4rpx solid #c39a59;
  color: #d8cab1;
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
}

.config-state.error {
  border-left-color: #b76555;
}

.config-state-title {
  font-size: 27rpx;
  font-weight: 600;
}

.config-state-description {
  color: #98a29d;
  font-size: 21rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.config-retry {
  background: transparent;
  border: 1rpx solid #c39a59;
  border-radius: 0;
  color: #d8b87e;
  font-size: 22rpx;
  margin: 20rpx 0 0;
  width: 190rpx;
}

.section-title {
  color: #e5d6bb;
  font-family: serif;
  font-size: 31rpx;
  font-weight: 500;
}

.requirement {
  border: 1rpx solid currentColor;
  display: inline-block;
  font-family: sans-serif;
  font-size: 17rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  margin-left: 12rpx;
  padding: 2rpx 8rpx;
  vertical-align: middle;
}

.requirement.required {
  color: #d6b477;
}

.requirement.optional {
  color: #809089;
}

.section-heading {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-step {
  align-items: center;
  border: 1rpx solid #b88d51;
  border-radius: 50%;
  color: #d6b477;
  display: flex;
  flex: 0 0 42rpx;
  font-size: 20rpx;
  height: 42rpx;
  justify-content: center;
  margin-top: 2rpx;
  width: 42rpx;
}

.section-description {
  color: #849089;
  font-size: 20rpx;
  line-height: 1.55;
  margin-top: 6rpx;
}

.option-scroll {
  white-space: nowrap;
}

.option {
  background: #202d28;
  border: 1rpx solid #35433d;
  color: #bdc5c0;
  display: inline-block;
  margin-right: 14rpx;
  min-height: 190rpx;
  padding: 15rpx;
  text-align: center;
  vertical-align: top;
  white-space: normal;
  width: 210rpx;
}

.option.selected {
  background: #c39a59;
  border-color: #c39a59;
  color: #16221e;
}

.option-none-mark {
  align-items: center;
  border: 1rpx solid #607069;
  border-radius: 50%;
  display: flex;
  font-size: 32rpx;
  height: 78rpx;
  justify-content: center;
  margin: 0 auto 8rpx;
  width: 78rpx;
}

.option-image {
  height: 78rpx;
  margin-bottom: 8rpx;
  width: 78rpx;
}

.option-name {
  font-size: 22rpx;
  line-height: 1.45;
  min-height: 64rpx;
  overflow-wrap: break-word;
}

.option-price {
  color: #86938c;
  font-size: 19rpx;
  margin-top: 5rpx;
}

.option.selected .option-price {
  color: rgba(22, 34, 30, .64);
}

.selected-option {
  border: 1rpx solid rgba(202, 169, 107, .44);
  color: #d5c4a5;
  display: inline-block;
  font-size: 21rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 9rpx 16rpx;
}

.engraving {
  background: #202d28;
  border-bottom: 2rpx solid #a77b40;
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  width: 100%;
}

.bottom-bar {
  background: #f3efe7;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  left: 0;
  padding: 18rpx 22rpx;
  position: fixed;
  right: 0;
  z-index: 20;
}

.bottom-bar button {
  border-radius: 0;
  flex: 1;
  font-size: 25rpx;
  margin: 0;
}

.secondary {
  background: transparent;
  border: 1rpx solid #8b6a3c;
  color: #714f24;
}

.primary {
  background: #17231f;
  color: #fff;
}
