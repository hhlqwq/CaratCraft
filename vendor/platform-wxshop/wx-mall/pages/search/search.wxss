page,
.container {
  background: #f3f0ea;
  min-height: 100%;
}

.search-header {
  align-items: center;
  background: #182421;
  display: flex;
  height: 112rpx;
  left: 0;
  padding: 0 28rpx;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 20;
}

.search-header .input-box {
  align-items: center;
  background: #fff;
  display: flex;
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  position: relative;
}

.search-header .icon {
  height: 28rpx;
  margin-right: 18rpx;
  width: 28rpx;
}

.search-header .keywrod {
  color: #26312d;
  flex: 1;
  font-size: 26rpx;
  height: 72rpx;
}

.search-header .del {
  height: 46rpx;
  width: 46rpx;
}

.search-header .right {
  color: #ddc58f;
  font-size: 25rpx;
  margin-left: 24rpx;
}

.no-search {
  padding-top: 136rpx;
}

.serach-keywords {
  background: #fff;
  margin: 0 24rpx 24rpx;
  padding: 30rpx 28rpx 12rpx;
}

.serach-keywords .h {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.serach-keywords .title {
  color: #26312d;
  font-family: serif;
  font-size: 32rpx;
  font-weight: 600;
}

.serach-keywords .icon {
  height: 44rpx;
  opacity: .62;
  width: 44rpx;
}

.serach-keywords .b {
  display: flex;
  flex-wrap: wrap;
}

.serach-keywords .item {
  border: 1rpx solid #d8d1c6;
  color: #6f675d;
  font-size: 23rpx;
  margin: 0 16rpx 18rpx 0;
  padding: 12rpx 22rpx;
}

.serach-keywords .item.active {
  background: #f0e7d8;
  border-color: #b38a50;
  color: #835e2f;
}

.shelper-list {
  background: #fff;
  margin-top: 112rpx;
  padding: 0 30rpx;
}

.shelper-list .item {
  border-bottom: 1rpx solid #ece7df;
  color: #36413c;
  font-size: 25rpx;
  line-height: 94rpx;
}

.sort {
  background: #fbfaf7;
  left: 0;
  position: fixed;
  right: 0;
  top: 112rpx;
  z-index: 18;
}

.sort-box {
  border-bottom: 1rpx solid #ded8ce;
  display: flex;
  height: 86rpx;
  padding: 0 24rpx;
}

.sort-box .item {
  color: #766f65;
  flex: 1;
  font-size: 25rpx;
  line-height: 86rpx;
  text-align: center;
}

.sort-box .item .txt {
  color: inherit;
}

.sort-box .item.active,
.sort-box .item.active .txt {
  color: #9d7139;
  font-weight: 600;
}

.sort-box-category {
  background: #fff;
  border-bottom: 1rpx solid #ded8ce;
  display: flex;
  flex-wrap: wrap;
  padding: 26rpx 28rpx 8rpx;
}

.sort-box-category .item {
  border: 1rpx solid #d9d2c7;
  color: #6f675d;
  font-size: 23rpx;
  margin: 0 16rpx 18rpx 0;
  padding: 10rpx 18rpx;
}

.sort-box-category .item.active {
  background: #f0e7d8;
  border-color: #ac8045;
  color: #815a2a;
}

.cate-item {
  padding: 222rpx 18rpx 30rpx;
}

.cate-item .b {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(2, 1fr);
}

.cate-item .b .item {
  background: #fff;
  min-width: 0;
  padding-bottom: 24rpx;
}

.cate-item .item .img {
  background: #eeece7;
  height: 342rpx;
  width: 100%;
}

.cate-item .item .name {
  color: #26312d;
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  margin: 18rpx 20rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cate-item .item .price {
  color: #9d7139;
  display: block;
  font-family: serif;
  font-size: 29rpx;
  margin: 10rpx 20rpx 0;
}

.search-result-empty {
  margin-top: 222rpx;
}

.search-result-empty .icon {
  height: 190rpx;
  opacity: .58;
  width: 190rpx;
}

.search-result-empty .text {
  margin-top: 24rpx;
}
