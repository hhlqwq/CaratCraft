page {
  background: #f5f2ec;
  color: #23332d;
}
.catalog-page {
  padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}
.intro {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 30rpx;
}
.eyebrow {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #8a754f;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
}
.description {
  font-size: 24rpx;
  color: #777066;
}
.search {
  padding: 25rpx;
  background: #fff;
  border-bottom: 2rpx solid #23332d;
  font-size: 25rpx;
  color: #777066;
}
.filters {
  padding: 24rpx 0;
}
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.chip {
  margin: 0;
  padding: 0 22rpx;
  min-height: 66rpx;
  line-height: 66rpx;
  font-size: 24rpx;
  background: #eae6de;
  color: #5e625a;
  border-radius: 8rpx;
}
.chip::after,
.retry::after,
.more::after {
  border: 0;
}
.chip.selected {
  background: #23332d;
  color: #fff;
}
.result-heading {
  font-size: 24rpx;
  color: #777066;
  margin-bottom: 22rpx;
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}
.product-card {
  background: #fff;
  overflow: hidden;
}
.product-image {
  width: 100%;
  height: 320rpx;
  background: #eae6de;
}
.product-copy {
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.product-name {
  font-size: 28rpx;
  overflow-wrap: anywhere;
}
.product-description {
  font-size: 22rpx;
  line-height: 1.6;
  color: #777066;
}
.price {
  font-size: 30rpx;
  color: #8a754f;
}
.status {
  text-align: center;
  padding: 56rpx 12rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #777066;
}
.retry,
.more {
  font-size: 25rpx;
  margin: 24rpx auto;
  background: #23332d;
  color: #fff;
  border-radius: 8rpx;
  width: 60%;
}
