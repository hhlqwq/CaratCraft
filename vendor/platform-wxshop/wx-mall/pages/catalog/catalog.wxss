page,
.container {
  background: #f5f2ec;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
}

.search {
  background: #f5f2ec;
  padding: 26rpx 28rpx 20rpx;
}

.search .input {
  align-items: center;
  background: #fff;
  border-bottom: 2rpx solid #23332d;
  display: flex;
  height: 78rpx;
  padding: 0 24rpx;
}

.search .icon {
  background: url(/static/images/icons/icon-search.png) center no-repeat;
  background-size: 100%;
  height: 28rpx;
  opacity: .65;
  width: 28rpx;
}

.search .txt {
  color: #777066;
  font-size: 24rpx;
  padding-left: 18rpx;
}

.catalog {
  display: flex;
  flex: 1;
  min-height: 0;
}

.catalog .nav {
  background: #17231f;
  height: 100%;
  width: 190rpx;
}

.catalog .nav .item {
  border-left: 5rpx solid transparent;
  color: #9fa9a3;
  font-size: 24rpx;
  line-height: 100rpx;
  padding-left: 28rpx;
  width: 190rpx;
}

.catalog .nav .item.active {
  background: rgba(199, 166, 103, .12);
  border-left-color: #c7a667;
  color: #e0c894;
  font-weight: 600;
}

.catalog .cate {
  background: #fff;
  flex: 1;
  height: 100%;
  padding: 0 28rpx 40rpx;
}

.banner {
  display: block;
  height: 250rpx;
  margin-top: 28rpx;
  overflow: hidden;
  position: relative;
}

.banner::after {
  background: linear-gradient(90deg, rgba(18, 29, 25, .62), rgba(18, 29, 25, .08));
  bottom: 0;
  content: '';
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}

.banner .image {
  height: 250rpx;
  width: 100%;
}

.banner .txt {
  bottom: 28rpx;
  color: #fff;
  font-family: serif;
  font-size: 30rpx;
  left: 24rpx;
  max-width: 330rpx;
  position: absolute;
  z-index: 1;
}

.catalog .hd {
  align-items: center;
  display: flex;
  height: 112rpx;
}

.catalog .hd .txt {
  color: #26312d;
  font-family: serif;
  font-size: 29rpx;
  font-weight: 600;
}

.catalog .hd .line {
  background: #c5a568;
  height: 2rpx;
  margin-right: 14rpx;
  width: 34rpx;
}

.catalog .hd .line:last-child {
  display: none;
}

.catalog .bd {
  display: grid;
  gap: 24rpx 18rpx;
  grid-template-columns: repeat(2, 1fr);
}

.catalog .bd .item {
  background: #f4f1eb;
  min-width: 0;
  padding-bottom: 16rpx;
}

.catalog .bd .item .icon {
  height: 190rpx;
  width: 100%;
}

.catalog .bd .item .txt {
  color: #46514c;
  display: block;
  font-size: 23rpx;
  margin-top: 13rpx;
  overflow: hidden;
  padding: 0 12rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
