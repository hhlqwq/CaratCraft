FROM eclipse-temurin:21-jre
ARG BUILD_REVISION=workspace
ENV BUILD_REVISION=${BUILD_REVISION}
LABEL org.opencontainers.image.revision=${BUILD_REVISION}
WORKDIR /app
RUN groupadd --system caratcraft \
    && useradd --system --gid caratcraft --home-dir /app caratcraft \
    && mkdir -p /data/uploads \
    && chown -R caratcraft:caratcraft /app /data/uploads
COPY --chown=caratcraft:caratcraft platform-admin.jar platform-api.jar /app/
COPY --chown=caratcraft:caratcraft HealthCheck.class /app/healthcheck/HealthCheck.class
COPY --chown=caratcraft:caratcraft legal/ /app/legal/
USER caratcraft
EXPOSE 8080 8081
