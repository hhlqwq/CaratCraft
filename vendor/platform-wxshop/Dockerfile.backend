FROM maven:3.9.11-eclipse-temurin-21 AS builder

WORKDIR /workspace

COPY pom.xml ./
COPY platform-common/pom.xml platform-common/pom.xml
COPY platform-biz/pom.xml platform-biz/pom.xml
COPY platform-admin/pom.xml platform-admin/pom.xml
COPY platform-api/pom.xml platform-api/pom.xml
COPY platform-common/src platform-common/src
COPY platform-biz/src platform-biz/src
COPY platform-admin/src platform-admin/src
COPY platform-api/src platform-api/src

RUN mvn -B -Pdev -pl platform-admin,platform-api -am package -DskipTests

FROM eclipse-temurin:21-jre

WORKDIR /app

RUN groupadd --system caratcraft \
    && useradd --system --gid caratcraft --home-dir /app caratcraft \
    && chown caratcraft:caratcraft /app

COPY --from=builder --chown=caratcraft:caratcraft \
    /workspace/platform-admin/target/platform-admin.jar /app/platform-admin.jar
COPY --from=builder --chown=caratcraft:caratcraft \
    /workspace/platform-api/target/platform-api.jar /app/platform-api.jar

USER caratcraft

EXPOSE 8080 8081
