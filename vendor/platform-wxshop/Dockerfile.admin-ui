FROM node:24-alpine AS builder

WORKDIR /workspace

RUN npm install --global pnpm@9.15.9

COPY platform-admin-ui/package.json platform-admin-ui/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY platform-admin-ui/ ./
COPY legal/ /legal/
RUN pnpm run build

FROM nginx:1.27-alpine
ARG BUILD_REVISION=workspace
LABEL org.opencontainers.image.revision=${BUILD_REVISION}

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/dist/ /usr/share/nginx/html/
COPY wx-mall/static/images/ /usr/share/nginx/html/static/images/
COPY legal/ /usr/share/nginx/html/legal/

EXPOSE 80
